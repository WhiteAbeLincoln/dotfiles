{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "links": [{"title": "Host logs", "type": "link", "url": "/d/globalhawk-logs?var-unit=$unit"}],
  "panels": [
    {"id": 1, "title": "CPU by mode", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * avg by (mode) (rate(node_cpu_seconds_total{cluster=\"globalhawk\",mode!=\"idle\"}[5m]))", "legendFormat": "{{mode}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent"}}},
    {"id": 2, "title": "Load average", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "node_load1{cluster=\"globalhawk\"}", "legendFormat": "1m", "refId": "A"}, {"expr": "node_load5{cluster=\"globalhawk\"}", "legendFormat": "5m", "refId": "B"}, {"expr": "node_load15{cluster=\"globalhawk\"}", "legendFormat": "15m", "refId": "C"}]},
    {"id": 3, "title": "Memory and swap used", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "node_memory_MemTotal_bytes{cluster=\"globalhawk\"} - node_memory_MemAvailable_bytes{cluster=\"globalhawk\"}", "legendFormat": "memory", "refId": "A"}, {"expr": "node_memory_SwapTotal_bytes{cluster=\"globalhawk\"} - node_memory_SwapFree_bytes{cluster=\"globalhawk\"}", "legendFormat": "swap", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "bytes"}}},
    {"id": 4, "title": "Network throughput", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (device) (rate(node_network_receive_bytes_total{cluster=\"globalhawk\",device!~\"lo|veth.*|cali.*\"}[5m]))", "legendFormat": "{{device}} receive", "refId": "A"}, {"expr": "-sum by (device) (rate(node_network_transmit_bytes_total{cluster=\"globalhawk\",device!~\"lo|veth.*|cali.*\"}[5m]))", "legendFormat": "{{device}} transmit", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "Bps"}}},
    {"id": 5, "title": "Root filesystem bytes", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "node_filesystem_size_bytes{cluster=\"globalhawk\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} - node_filesystem_avail_bytes{cluster=\"globalhawk\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}", "legendFormat": "used", "refId": "A"}, {"expr": "node_filesystem_avail_bytes{cluster=\"globalhawk\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}", "legendFormat": "available", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "bytes"}}},
    {"id": 6, "title": "Root and ZFS inode use", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_filesystem_files_free{cluster=\"globalhawk\",mountpoint=\"/\"} / node_filesystem_files{cluster=\"globalhawk\",mountpoint=\"/\"})", "legendFormat": "root", "refId": "A"}, {"expr": "100 * (1 - node_filesystem_files_free{cluster=\"globalhawk\",fstype=\"zfs\"} / node_filesystem_files{cluster=\"globalhawk\",fstype=\"zfs\"})", "legendFormat": "{{mountpoint}}", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "percent"}}},
    {"id": 7, "title": "ZFS capacity", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "zfs_pool_allocated_bytes{cluster=\"globalhawk\"}", "legendFormat": "{{pool}} allocated", "refId": "A"}, {"expr": "zfs_pool_free_bytes{cluster=\"globalhawk\"}", "legendFormat": "{{pool}} free", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "bytes"}}},
    {"id": 8, "title": "ZFS health and fragmentation", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "zfs_pool_health{cluster=\"globalhawk\"}", "legendFormat": "{{pool}} health code", "refId": "A"}, {"expr": "100 * zfs_pool_fragmentation_ratio{cluster=\"globalhawk\"}", "legendFormat": "{{pool}} fragmentation", "refId": "B"}]},
    {"id": 9, "title": "Hardware temperatures", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "node_hwmon_temp_celsius{cluster=\"globalhawk\"}", "legendFormat": "{{chip}} {{sensor}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "celsius"}}},
    {"id": 10, "title": "Disk SMART health", "type": "stat", "gridPos": {"h": 7, "w": 6, "x": 0, "y": 24}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "smartctl_device_smart_status{cluster=\"globalhawk\"}", "legendFormat": "{{device}}", "refId": "A"}]},
    {"id": 11, "title": "Disk temperature", "type": "timeseries", "gridPos": {"h": 7, "w": 6, "x": 6, "y": 24}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "smartctl_device_temperature{cluster=\"globalhawk\"}", "legendFormat": "{{device}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "celsius"}}},
    {"id": 12, "title": "NVMe wear", "type": "timeseries", "gridPos": {"h": 7, "w": 6, "x": 12, "y": 24}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "smartctl_device_percentage_used{cluster=\"globalhawk\"}", "legendFormat": "{{device}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent"}}},
    {"id": 13, "title": "NVMe media errors", "type": "timeseries", "gridPos": {"h": 7, "w": 6, "x": 18, "y": 24}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "smartctl_device_media_errors{cluster=\"globalhawk\"}", "legendFormat": "{{device}}", "refId": "A"}]},
    {"id": 14, "title": "Failed important systemd units", "type": "table", "gridPos": {"h": 7, "w": 8, "x": 0, "y": 31}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "node_systemd_unit_state{cluster=\"globalhawk\",state=\"failed\"} == 1", "format": "table", "instant": true, "refId": "A"}]},
    {"id": 15, "title": "Restic last success age", "type": "stat", "gridPos": {"h": 7, "w": 8, "x": 8, "y": 31}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "time() - restic_backup_last_success_timestamp_seconds{cluster=\"globalhawk\"}", "legendFormat": "{{backup}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 16, "title": "Host journal", "type": "logs", "gridPos": {"h": 7, "w": 8, "x": 16, "y": 31}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "{source=\"nixos\",unit=~\"$unit\"}", "refId": "A"}]}
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["globalhawk", "host"],
  "templating": {"list": [{"name": "unit", "label": "Unit", "type": "query", "datasource": {"type": "loki", "uid": "loki"}, "query": {"type": 1, "label": "unit", "stream": "{source=\"nixos\"}"}, "current": {"text": "All", "value": ".*"}, "includeAll": true, "allValue": ".*", "refresh": 2}]},
  "time": {"from": "now-24h", "to": "now"},
  "timezone": "browser",
  "title": "Host Health",
  "uid": "globalhawk-host",
  "version": 1
}
